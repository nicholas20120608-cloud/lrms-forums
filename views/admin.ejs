<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - LRMS Forums</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1>Admin Panel</h1>
    <nav>
      <a href="/">Home</a>
      <a href="/logout">Logout</a>
    </nav>
  </header>
  <main>
    <section>
      <h2>Users</h2>
      <ul>
        <% users.forEach(user => { %>
          <li>
            <% if (user.profile_image) { %>
              <img src="/uploads/<%= user.profile_image %>" alt="Profile Picture" class="pfp-small">
            <% } %>
            <%= user.username %> (<%= user.role %>)
            <% if (user.role !== 'admin') { %>
              <form action="/admin/promote/<%= user.id %>" method="POST" style="display:inline;">
                <button type="submit">Promote to Admin</button>
              </form>
            <% } %>
          </li>
        <% }) %>
      </ul>
    </section>
  </main>
</body>
</html>